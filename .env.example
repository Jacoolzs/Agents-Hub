NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=./data/agents-hub.sqlite
CORS_ORIGINS=http://localhost:5173
AUTH_TOKEN_TTL_SECONDS=3600
LOCK_DEFAULT_TTL_SECONDS=300
LOG_LEVEL=info
MAINTENANCE_INTERVAL_SECONDS=15
SESSION_IDLE_SECONDS=60
SESSION_EXPIRE_SECONDS=180
RATE_LIMIT_IP_PER_MINUTE=60000
RATE_LIMIT_USER_PER_MINUTE=3000
WS_MAX_CONNECTIONS=200
EVENT_RETENTION_DAYS=30
# Optional: serve the production dashboard from the Hub
# WEB_STATIC_DIR=./apps/web/dist
